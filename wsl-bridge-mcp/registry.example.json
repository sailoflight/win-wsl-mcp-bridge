{
  "servers": [
    {
      "id": "example-wsl-mcp",
      "name": "Example WSL MCP",
      "summary": "Replace this entry with a standard WSL stdio MCP command.",
      "transport": {"type": "stdio"},
      "management": {
        "ownership": "bridge-managed",
        "agentControl": {"enabled": false, "allowedActions": []}
      },
      "command": "python3",
      "args": ["-m", "your_mcp"],
      "process": {
        "multiProcessAllowed": null,
        "enforcement": "unverified",
        "note": "Set false for bridge-enforced shared JSON-RPC mode; true keeps dedicated byte-transparent processes."
      },
      "capabilityGroups": ["example"],
      "artifactDelivery": {
        "enabled": false,
        "maxBytes": 536870912
      },
      "inputDelivery": {
        "enabled": false,
        "maxBytes": 268435456
      }
    },
    {
      "id": "example-http-wsl",
      "name": "Example WSL Streamable HTTP MCP",
      "summary": "Replace this entry with an owner-host loopback Streamable HTTP MCP. The endpoint and controlContract paths must point at the real service; the contract never names a command, service, container, or pid.",
      "transport": {
        "type": "streamable-http",
        "endpoint": "http://127.0.0.1:9443/mcp",
        "headers": {"Authorization": "Bearer replace-me"}
      },
      "management": {
        "ownership": "external-controlled",
        "agentControl": {"enabled": false, "allowedActions": []},
        "controlContract": {
          "restart": {
            "method": "POST",
            "path": "/control/restart",
            "timeoutSeconds": 10,
            "successStatuses": [200, 202],
            "readiness": {
              "method": "GET",
              "path": "/ready",
              "timeoutSeconds": 5,
              "successStatuses": [200]
            }
          },
          "stop": {
            "method": "POST",
            "path": "/control/stop",
            "timeoutSeconds": 10,
            "successStatuses": [200, 202]
          }
        }
      },
      "process": {"multiProcessAllowed": null, "enforcement": "unverified"},
      "capabilityGroups": ["example", "http"],
      "artifactDelivery": {"enabled": false},
      "inputDelivery": {"enabled": false}
    }
  ]
}
